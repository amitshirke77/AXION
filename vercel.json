{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "regions": [
    "bom1"
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{views/**,seed/**,lib/**,public/monogram.png,public/recur.js,public/plan.js,assets/**,node_modules/pdfkit/js/data/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/requests",
      "schedule": "15 4 * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "0 3 * * 1"
    }
  ]
}
